class Solution:
    def calPoints(self, operations: List[str]) -> int:
        record=[]
        for i in range(len(operations)):
            if operations[i]=='+':
                if len(record)>=2:
                    record.append(record[-1]+record[-2])
            elif operations[i]=='D':
                if len(record)>=1:
                    record.append(record[-1]*2)
            elif operations[i]=='C':
                if len(record)>=1:
                    record=record[:-1]
            else:
                record.append(int(operations[i]))
        print(record)
        return sum(record)
