class Solution:
    def diagonalSum(self, mat: List[List[int]]) -> int:
        n=len(mat)
        m=len(mat[0])
        s=0
        for i in range(n):
            for j in range(m):
                if i==j:
                    s+=mat[i][j]
                elif i+j==n-1:
                    s+=mat[i][j]
            print(s)
        return s
